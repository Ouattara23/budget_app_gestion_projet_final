# Configuration Firebase côté navigateur (à ajouter aussi dans Vercel > Settings > Environment Variables).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Clés privées : renseignez au moins la clé Gemini pour activer Amia.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Fournisseurs de secours, appelés dans cet ordre après Gemini.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
OPENROUTER_API_KEY=
OPENROUTER_MODEL=mistralai/mistral-small-3.2-24b-instruct

# Formulaire de contact (Resend). Requiert un domaine d'envoi vérifié.
RESEND_API_KEY=
CONTACT_EMAIL_TO=
CONTACT_EMAIL_FROM=

# URL publique utilisée pour identifier le site auprès d'OpenRouter.
NEXT_PUBLIC_APP_URL=http://localhost:3000
